{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": true
  },
  "include": [
    "react/**/*.tsx",
    "react/**/*.d.ts",
    "vite.config.ts"
  ]
}
